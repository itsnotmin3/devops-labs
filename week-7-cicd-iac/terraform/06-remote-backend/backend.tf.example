# Copy to backend.tf and set your bucket name:
#   cp backend.tf.example backend.tf
#
# Then:  terraform init -migrate-state

terraform {
  backend "s3" {
    bucket = "acme-tfstate-4471" # <- YOUR bucket, created by hand first
    key    = "dev/full-environment/terraform.tfstate"
    region = "ap-south-1"

    encrypt = true

    # S3-native locking (Terraform 1.10+ / AWS provider 5.x+).
    # Stops two concurrent applies from corrupting state.
    use_lockfile = true

    # The OLD way, which you will still see everywhere:
    # dynamodb_table = "terraform-locks"
  }
}

# NOTE: backend config cannot use variables or interpolation. It is read
# before Terraform evaluates anything else. That is why the bucket name is
# hard-coded here and why teams use `-backend-config=prod.hcl` files instead.
